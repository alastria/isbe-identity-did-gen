{
  "name": "isbe-did-gen",
  "version": "3.0.0",
  "scripts": {
    "build": "tsc",
    "did-gen": "ts-node src/index.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "did",
    "did:isbe"
  ],
  "author": "ISBE",
  "license": "Apache-2.0",
  "description": "CLI tool to generate did:isbe identifiers and sign registry transactions",
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "bs58": "6.0.0",
    "commander": "14.0.2",
    "elliptic": "6.6.1",
    "ethers": "6.15.0"
  },
  "devDependencies": {
    "@types/elliptic": "6.4.18",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "jest": "30.2.0",
    "ts-jest": "29.4.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-2.0.txt"
  ],
  "bin": {
    "did-gen": "dist/index.js"
  },
  "main": "dist/index.js"
}
